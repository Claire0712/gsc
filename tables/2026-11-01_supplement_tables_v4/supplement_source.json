{
  "variables": [
    {
      "variable": "Tmax",
      "unit": "\u00b0C",
      "source": "ERA5 t2m and fixed population",
      "definition": "UTC daily pixel maximum before country aggregation; not maximum of country hourly averages."
    },
    {
      "variable": "Tmin",
      "unit": "\u00b0C",
      "source": "ERA5 t2m and fixed population",
      "definition": "UTC daily pixel minimum; not exact civil-night temperature and never changes the Tmax event end."
    },
    {
      "variable": "Dewpoint",
      "unit": "\u00b0C",
      "source": "ERA5 d2m",
      "definition": "Hourly-derived daily country mean; not an observed equipment heat index."
    },
    {
      "variable": "Q90",
      "unit": "\u00b0C",
      "source": "2018\u20132021 Tmax/Tmin",
      "definition": "Circular 365-day \u00b115-day window, linear quantile; at least 112 observations/all four years. Feb 29 averages adjacent thresholds."
    },
    {
      "variable": "Warm season",
      "unit": "start month",
      "source": "2018\u20132021 Tmax",
      "definition": "Hottest consecutive three months by day-weighted mean; earliest start breaks ties; LOYO stability reported."
    },
    {
      "variable": "Heat load HD",
      "unit": "\u00b0C-days",
      "source": "Tmax excess over Q90",
      "definition": "Sum of positive Tmax excess within the fixed analysis event; bridge days retain zero excess."
    },
    {
      "variable": "Hot days and span",
      "unit": "days",
      "source": "Tmax-only catalogue",
      "definition": "Hot days count exceedances; span includes bridges. Analysis processes merge until seven complete cool days separate them."
    },
    {
      "variable": "NTRD",
      "unit": "\u00b0C-days",
      "source": "Tmin excess over its Q90",
      "definition": "Positive Tmin excess over the same fixed Tmax event; secondary load only."
    },
    {
      "variable": "Connection reference",
      "unit": "signal units",
      "source": "IODA ten-minute grid",
      "definition": "Median of eligible same-weekday/time observations \u00b17/14/21/28 days; at least 4 eligible references with both temporal sides; valid zeros count, but the final median must be positive. Retrospective."
    },
    {
      "variable": "Signed deviation",
      "unit": "ratio",
      "source": "C / reference \u2212 1",
      "definition": "Keeps positive and negative fluctuations; not percentage of residents disconnected."
    },
    {
      "variable": "Truncated deficit",
      "unit": "ratio",
      "source": "max(0,1 \u2212 C/reference)",
      "definition": "Nonnegative shortfall; ordinary fluctuations can produce positive deficits."
    },
    {
      "variable": "Core maintenance",
      "unit": "fraction",
      "source": "IODA/reference",
      "definition": "Core slots with ratio at least 0.95 divided by all required core slots; not an SLA."
    },
    {
      "variable": "Core and full peak loss",
      "unit": "ratio",
      "source": "IODA/reference",
      "definition": "Maximum truncated deficit within core or core plus 72 hours, separately labelled."
    },
    {
      "variable": "DHRD",
      "unit": "deficit-hours",
      "source": "IODA/reference",
      "definition": "Deficit sum times 1/6 hour over the entire fixed core plus 72 hours; incomplete windows remain missing."
    },
    {
      "variable": "Unit-time deficit",
      "unit": "ratio",
      "source": "DHRD / required hours",
      "definition": "Mean full-window truncated deficit; separates accumulation length from average deficit."
    },
    {
      "variable": "Disruption duration",
      "unit": "hours",
      "source": "IODA/reference",
      "definition": "Slots below 0.95 times 1/6 hour, separately for core, post-event and full window."
    },
    {
      "variable": "Stable recovery",
      "unit": "hours after Tmax end",
      "source": "Core-conditioned IODA/reference",
      "definition": "Completion of 24 consecutive ten-minute slots at or above 0.95; 72-hour, administrative and missingness censoring distinct."
    },
    {
      "variable": "Pre-event stability",
      "unit": "MAD / median",
      "source": "Raw pre-event IODA",
      "definition": "Dimensionless connection dispersion, not physical backup power or adaptation capacity."
    },
    {
      "variable": "Capability modifiers",
      "unit": "source units / fractions",
      "source": "World Bank",
      "definition": "Newest valid prior year within 3 years; publication-time availability unknown. GDP retains constant-PPP archive units."
    },
    {
      "variable": "DLEP",
      "unit": "population-weighted deficit proxy",
      "source": "AP DHRD \u00d7 fixed 2025 population \u00d7 Internet fraction",
      "definition": "Current calendar year preferred then recent prior 3 years; separate from strictly lagged capability modifiers; not actual disconnected people/person-hours."
    },
    {
      "variable": "Precipitation adjustment",
      "unit": "mm per UTC day",
      "source": "ERA5-Land accumulated precipitation",
      "definition": "Audited daily labels and fixed-population support; only a supported daily subset, not certified adjustment in all primary models."
    },
    {
      "variable": "Wind",
      "unit": "m s\u207b\u00b9",
      "source": "Existing 2024 u/v country means",
      "definition": "Magnitude of mean components, not gust or mean scalar speed; four retained months and paired subset only."
    }
  ],
